<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <radialGradient id="baseGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FDE047" stop-opacity="0.9"/>
      <stop offset="60%" stop-color="#F59E0B" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#D97706" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047"/>
      <stop offset="50%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#D97706"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Ambient Aura -->
  <circle cx="256" cy="256" r="230" fill="url(#baseGlow)"/>

  <!-- Outer Decorative Ring -->
  <circle cx="256" cy="256" r="200" fill="none" stroke="url(#ringGrad)" stroke-width="12" filter="url(#glow)"/>
  <circle cx="256" cy="256" r="175" fill="none" stroke="#FDE047" stroke-width="4" stroke-dasharray="8 6"/>

  <!-- Ornate Crown / Crest Top -->
  <g transform="translate(256, 50)" text-anchor="middle">
    <circle cx="0" cy="0" r="32" fill="#FDE047" filter="url(#glow)"/>
    <text y="14" font-size="34" text-anchor="middle">👑</text>
  </g>

  <!-- Avatar Placeholder Cutout Center -->
  <circle cx="256" cy="256" r="145" fill="#0f172a" stroke="#FDE047" stroke-width="4"/>

  <!-- Bottom Badge Tag -->
  <g transform="translate(256, 450)">
    <rect x="-80" y="-20" width="160" height="40" rx="20" fill="url(#ringGrad)" stroke="#ffffff" stroke-width="2" filter="url(#glow)"/>
    <text x="0" y="7" fill="#ffffff" font-family="'Outfit', sans-serif" font-weight="900" font-size="14" text-anchor="middle" letter-spacing="1">FRAME</text>
  </g>

  <!-- Sparkles -->
  <circle cx="80" cy="160" r="5" fill="#FDE047" filter="url(#glow)"/>
  <circle cx="430" cy="160" r="5" fill="#FDE047" filter="url(#glow)"/>
  <circle cx="100" cy="380" r="4" fill="#F59E0B" filter="url(#glow)"/>
  <circle cx="410" cy="380" r="4" fill="#F59E0B" filter="url(#glow)"/>
</svg>